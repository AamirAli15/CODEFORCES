import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int x = sc.nextInt();

        int steps = 0;

        steps += x / 5;
        x = x % 5;

        if (x > 0) {
            steps++;
        }

        System.out.println(steps);
    }
}
